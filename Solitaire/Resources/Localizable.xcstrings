    "New games are dealt until the solver finds a way to win one; a deal number you enter is played as it is." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Spiele werden ausgeteilt, bis der Löser einen Weg zum Sieg findet; eine eingegebene Spielnummer wird gespielt, wie sie ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las partidas nuevas se reparten hasta que el solucionador encuentra cómo ganar una; un número de reparto que escribas se juega tal cual."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouvelles parties sont distribuées jusqu’à ce que le solveur trouve comment en gagner une; un numéro de donne entré est joué tel quel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si distribuiscono nuove partite finché il risolutore non trova il modo di vincerne una; un numero di mano inserito viene giocato tale e quale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソルバーが勝てる方法を見つけるまで新しいゲームが配られます。番号を入力した場合は、そのディールがそのまま配られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해결 가능한 배열을 찾을 때까지 새 게임이 계속 배분되며, 입력한 배열 번호는 그대로 플레이됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwe spellen worden gedeeld totdat de oplosser een manier vindt om er een te winnen; een ingevoerd delingnummer wordt gespeeld zoals het is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novas partidas são distribuídas até o solucionador encontrar uma que possa ser vencida; uma distribuição cujo número você digitar será jogada como está."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始新游戏时会不断重新发牌，直到求解器找到可解的牌局；你输入编号的牌局则会直接开始。"
          }
        }
      }
    },
