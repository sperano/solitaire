    "Diamonds blue and clubs green, so no two suits share a colour." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karo in Blau und Kreuz in Grün, damit keine zwei Farben gleich gefärbt sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los diamantes en azul y los tréboles en verde, para que cada palo tenga su color."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les carreaux en bleu et les trèfles en vert, pour que chaque enseigne ait sa couleur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quadri blu e fiori verdi, così nessun seme condivide il colore con un altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダイヤは青、クラブは緑になり、同じ色のスートがなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다이아몬드는 파란색, 클럽은 초록색으로 표시되어 두 무늬가 같은 색을 공유하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruiten zijn blauw en klaveren groen, zodat elke kleur een eigen kleur heeft."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouros em azul e paus em verde, para que nenhum naipe tenha a mesma cor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "方块显示为蓝色，梅花显示为绿色，让四种花色各有不同颜色。"
          }
        }
      }
    },
