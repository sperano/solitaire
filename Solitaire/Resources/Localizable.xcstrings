    "Double-tap to move it to the best spot, or swipe up or down to choose" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppeltippen, um sie an die beste Stelle zu legen, oder zum Auswählen nach oben oder unten streichen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces para moverla al mejor lugar, o desliza hacia arriba o hacia abajo para elegir"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez deux fois pour la déplacer au meilleur endroit, ou balayez vers le haut ou le bas pour choisir"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca due volte per spostarla nel posto migliore, oppure scorri su o giù per scegliere"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダブルタップで最適な場所に移動します。上下にスワイプすると移動先を選べます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 번 탭하면 최적의 위치로 이동하거나, 위아래로 스와이프하여 선택하세요"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dubbeltik om hem naar de beste plek te verplaatsen, of veeg omhoog of omlaag om te kiezen"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque duas vezes para movê-la ao melhor lugar ou deslize para cima ou para baixo para escolher"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点两下即可移到最佳位置，或上下轻扫进行选择"
          }
        }
      }
    },
