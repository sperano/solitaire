        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해결 가능한 배열을 찾을 때까지 새 게임이 계속 배분되며, 입력한 배열 번호는 그대로 플레이됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
