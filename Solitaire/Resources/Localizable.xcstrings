    "Every deal has a number. Share it, or enter one to play that deal again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Spiel hat eine Nummer. Teile sie oder gib eine ein, um dieses Spiel noch einmal zu spielen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada reparto tiene un número. Compártelo, o escribe uno para volver a jugar ese reparto."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque donne a un numéro. Partagez-le, ou entrez-en un pour rejouer cette donne."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 카드 배열에는 번호가 있습니다. 번호를 공유하거나 입력하여 같은 배열을 다시 플레이하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
