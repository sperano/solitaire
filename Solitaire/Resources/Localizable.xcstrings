        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada reparto tiene un número. Compártelo, o escribe uno para volver a jugar ese reparto."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
